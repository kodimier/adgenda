# Copie para .env na raiz ou use as variáveis nos apps.

# API
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# APP_PUBLIC_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://adgenda:adgenda@localhost:5432/adgenda

# SMTP de desenvolvimento (Mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM=adgenda@localhost

# Produção: com BREVO_API_KEY os convites saem pela Brevo; sem chave, Mailpit.
# BREVO_API_KEY=
# MAIL_FROM=Adgenda <noreply@localhost>
